---
import { wins } from '../../data/site';
import ToolCallHeader from './ToolCallHeader.astro';
---

<section id="step4" class="step" aria-labelledby="step4-heading">
  <ToolCallHeader call={wins.call} status={wins.status} />
  <h2 id="step4-heading" class="sr-only">Achievements</h2>
  <div class="grid">
    {
      wins.items.map((item) => (
        <div class:list={['card', { highlighted: item.highlighted }]}>
          <p class="emoji" aria-hidden="true">
            {item.emoji}
          </p>
          <p class="title">{item.title}</p>
          <p class="desc">{item.description}</p>
        </div>
      ))
    }
  </div>
</section>

<style>
  .step {
    animation: rise 0.6s 0.4s ease both;
    margin-bottom: 36px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .card {
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 26px 30px;
    background: var(--color-surface);
  }

  .card.highlighted {
    border-color: var(--color-border-strong);
    background: var(--color-surface-gradient);
  }

  .emoji {
    font-size: 26px;
    margin: 0 0 10px;
  }

  .title {
    font: 700 17px var(--font-sans);
    margin: 0 0 6px;
  }

  .desc {
    margin: 0;
    font: 400 14px/1.65 var(--font-sans);
    color: var(--color-text-muted);
  }

  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
