---
import { skills } from '../../data/site';
import ToolCallHeader from './ToolCallHeader.astro';
---

<section id="step3" class="step" aria-labelledby="step3-heading">
  <ToolCallHeader
    call={skills.call}
    status={skills.status}
    plainLabel="checking skills used in real production code"
  />
  <h2 id="step3-heading" class="sr-only">Skills</h2>
  <dl class="json">
    <span class="brace" aria-hidden="true">{'{'}</span>
    {
      skills.groups.map((group) => (
        <div class="entry">
          <dt>"{group.key}"</dt>
          <dd>[{group.items.map((item) => `"${item}"`).join(', ')}]</dd>
        </div>
      ))
    }
    <span class="brace" aria-hidden="true">{'}'}</span>
  </dl>
</section>

<style>
  .step {
    animation: rise 0.6s 0.3s ease both;
    margin-bottom: 36px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .json {
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 24px 28px;
    background: var(--color-surface-alt);
    font-size: 13px;
    line-height: 2.1;
    margin: 0;
  }

  .brace {
    color: var(--color-text-faint);
    display: block;
  }

  .entry {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    padding-left: 24px;
  }

  dt {
    color: var(--color-accent);
  }

  dt::after {
    content: ':';
    color: var(--color-text-faint);
  }

  dd {
    margin: 0;
    color: var(--color-text);
  }
</style>
