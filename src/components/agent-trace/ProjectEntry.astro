---
interface Props {
  title: string;
  description: string;
  stack: string;
  badge?: string;
  layout: 'spotlight' | 'default' | 'wide';
}

const { title, description, stack, badge, layout } = Astro.props;
---

<div class:list={['entry', layout]}>
  <div class:list={['heading', { split: layout === 'spotlight' }]}>
    <h3>{title}</h3>
    {badge && <span class="badge">{badge}</span>}
  </div>
  <p class="desc">{description}</p>
  <p class="stack">{stack}</p>
</div>

<style>
  .entry {
    border-radius: 12px;
    padding: 24px 28px;
    background: var(--color-surface);
  }

  .entry.spotlight {
    border: 1px solid var(--color-border-strong);
    border-left: 3px solid var(--color-accent);
    border-radius: 0 12px 12px 0;
    padding: 28px 32px;
    background: var(--color-surface-gradient);
  }

  .entry.default,
  .entry.wide {
    border: 1px solid var(--color-border);
    transition: border-color 0.2s;
  }

  .entry.default:hover,
  .entry.wide:hover {
    border-color: var(--color-accent);
  }

  .heading {
    margin-bottom: 8px;
  }

  .heading.split {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 10px;
  }

  h3 {
    margin: 0;
    font: 700 18px var(--font-sans);
  }

  .spotlight h3 {
    font-size: 24px;
  }

  .badge {
    background: var(--color-accent);
    color: var(--color-on-accent);
    font: 700 11px var(--font-mono);
    padding: 4px 10px;
    border-radius: 4px;
    white-space: nowrap;
  }

  .desc {
    margin: 0 0 12px;
    font: 400 14px/1.65 var(--font-sans);
    color: var(--color-text-muted);
  }

  .spotlight .desc,
  .wide .desc {
    font-size: 15px;
    line-height: 1.7;
    max-width: 640px;
  }

  .stack {
    margin: 0;
    font-size: 12px;
    color: var(--color-text-dim);
  }
</style>
