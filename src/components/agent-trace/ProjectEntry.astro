---
interface Props {
  title: string;
  description: string;
  stack: string;
  badge?: string;
  repo?: string;
  demo?: string;
  layout: 'spotlight' | 'default' | 'wide';
}

const { title, description, stack, badge, repo, demo, layout } = Astro.props;
---

<div class:list={['entry', layout]}>
  <div class:list={['heading', { split: Boolean(badge) }]}>
    <h3>{title}</h3>
    {badge && <span class="badge">{badge}</span>}
  </div>
  <p class="desc">{description}</p>
  <div class="footer">
    <p class="stack">{stack}</p>
    <div class="links">
      {
        demo && (
          <a class="demo-link" href={demo} target="_blank" rel="noopener noreferrer">
            Live demo ↗
          </a>
        )
      }
      {
        repo && (
          <a class="repo-link" href={repo} target="_blank" rel="noopener noreferrer">
            View repo ↗
          </a>
        )
      }
    </div>
  </div>
</div>

<style>
  .entry {
    border-radius: 12px;
    padding: 24px 28px;
    background: var(--color-surface);
  }

  .entry.spotlight {
    grid-column: 1 / -1;
    border: 1px solid var(--color-accent);
    border-radius: 14px;
    padding: 28px 32px;
    background: var(--color-surface-gradient);
  }

  .entry.wide {
    grid-column: 1 / -1;
  }

  .entry.default,
  .entry.wide {
    border: 1px solid var(--color-border);
    transition: border-color 0.2s;
  }

  .entry.default:hover,
  .entry.wide:hover {
    border-color: var(--color-accent);
  }

  .heading {
    margin-bottom: 8px;
  }

  .heading.split {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 10px;
  }

  h3 {
    margin: 0;
    font: 700 18px var(--font-sans);
  }

  .spotlight h3 {
    font-size: 24px;
  }

  .badge {
    background: var(--color-accent);
    color: var(--color-on-accent);
    font: 700 11px var(--font-mono);
    padding: 4px 10px;
    border-radius: 4px;
    white-space: nowrap;
  }

  .desc {
    margin: 0 0 12px;
    font: 400 14px/1.65 var(--font-sans);
    color: var(--color-text-muted);
  }

  .spotlight .desc,
  .wide .desc {
    font-size: 15px;
    line-height: 1.7;
    max-width: 640px;
  }

  .footer {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  .stack {
    margin: 0;
    font-size: 12px;
    color: var(--color-text-dim);
  }

  .links {
    display: flex;
    gap: 16px;
  }

  .repo-link,
  .demo-link {
    font: 500 12px var(--font-mono);
    color: var(--color-text-dim);
    white-space: nowrap;
  }

  .repo-link:hover,
  .demo-link:hover {
    color: var(--color-accent);
  }

  .demo-link {
    color: var(--color-accent);
  }
</style>
