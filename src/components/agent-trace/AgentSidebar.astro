---
import { content } from '../../i18n/content';
import LanguageToggle from './LanguageToggle.astro';

const { agent, audienceMeta, traceSteps } = content.en;
const enAudiences = content.en.audiences;
const esAudiences = content.es.audiences;
const currentIndex = 0;
---

<header class="sidebar">
  <div class="status">
    <span class="dot" aria-hidden="true"></span>
    <span class="agent-name">agent: {agent.name}</span>
  </div>

  <LanguageToggle />

  <p class="sr-only" id="audience-announcer" role="status" aria-live="polite"></p>

  <div class="viewing-as" role="group" aria-label="Viewing as" data-i18n-attr="aria-label:ui.viewingAsAriaLabel">
    <p class="comment" aria-hidden="true" data-i18n="ui.commentViewingAs">// viewing as</p>
    <div class="toggle">
      {
        audienceMeta.map((meta, index) => {
          const en = enAudiences[index];
          const es = esAudiences[index];
          return (
            <button
              type="button"
              data-audience={meta.id}
              data-from={meta.from}
              data-task={meta.task}
              data-filters={meta.filters}
              data-label-en={en.label}
              data-label-es={es.label}
              data-query-en={en.query}
              data-query-es={es.query}
              data-accent-en={en.accent}
              data-accent-es={es.accent}
              data-body-en={en.body}
              data-body-es={es.body}
              data-cta-en={en.cta}
              data-cta-es={es.cta}
              aria-pressed={index === currentIndex ? 'true' : 'false'}
            >
              {en.label}
            </button>
          );
        })
      }
    </div>
  </div>

  <dl class="session">
    <p class="comment" aria-hidden="true" data-i18n="ui.commentSession">// session</p>
    <div class="row"><dt data-i18n="ui.sessionTask">task:</dt> <dd id="session-task">{audienceMeta[currentIndex].task}</dd></div>
    <div class="row"><dt data-i18n="ui.sessionFilters">filters:</dt> <dd id="session-filters">{audienceMeta[currentIndex].filters}</dd></div>
    <div class="row"><dt data-i18n="ui.sessionRegion">region:</dt> <dd>{agent.session.region}</dd></div>
    <div class="row">
      <dt data-i18n="ui.sessionStatus">status:</dt> <dd class="status-ok">● {agent.session.status}</dd>
    </div>
  </dl>

  <nav aria-label="Trace steps" data-i18n-attr="aria-label:ui.traceStepsAriaLabel">
    <p class="comment" aria-hidden="true" data-i18n="ui.commentTraceSteps">// trace steps</p>
    <ol>
      {
        traceSteps.map((step) => (
          <li>
            <a href={`#${step.id}`}>{step.label}</a>
          </li>
        ))
      }
    </ol>
  </nav>

  <div class="context-group">
    <div class="context">
      <div class="context-label">
        <span data-i18n="ui.contextLabel">context</span>
        <span id="context-count">{Math.round((1 / traceSteps.length) * 100)}%</span>
      </div>
      <div class="context-track" role="progressbar" aria-label="Sections read" data-i18n-attr="aria-label:ui.sectionsReadAriaLabel" aria-valuemin="0" aria-valuemax="100" aria-valuenow="20">
        <div class="context-fill" id="context-fill"></div>
      </div>
    </div>

    <p class="comment raw-data-hint" data-i18n="ui.commentRawDataHint">// press ` for raw data</p>
  </div>
</header>

<script>
  import { getCurrentLang, onLangChange, content } from '../../i18n/client';

  const STORAGE_KEY = 'thomas-portfolio:audience';

  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-audience]');
  const fromEl = document.getElementById('query-from');
  const taskEl = document.getElementById('session-task');
  const filtersEl = document.getElementById('session-filters');
  const queryEl = document.getElementById('query-text');
  const accentEl = document.getElementById('rec-accent');
  const bodyEl = document.getElementById('rec-body');
  const ctaEl = document.getElementById('rec-cta');
  const announcerEl = document.getElementById('audience-announcer');

  function flash(el: HTMLElement | null) {
    if (!el) return;
    el.classList.remove('swap-flash');
    // Force reflow so the animation restarts if triggered again quickly.
    void el.offsetWidth;
    el.classList.add('swap-flash');
  }

  function applyAudience(button: HTMLButtonElement, announce = true) {
    buttons.forEach((other) => other.setAttribute('aria-pressed', String(other === button)));

    const lang = getCurrentLang();
    const { from, task, filters } = button.dataset;
    const label = lang === 'es' ? button.dataset.labelEs : button.dataset.labelEn;
    const query = lang === 'es' ? button.dataset.queryEs : button.dataset.queryEn;
    const accent = lang === 'es' ? button.dataset.accentEs : button.dataset.accentEn;
    const body = lang === 'es' ? button.dataset.bodyEs : button.dataset.bodyEn;
    const cta = lang === 'es' ? button.dataset.ctaEs : button.dataset.ctaEn;

    if (label) button.textContent = label;
    if (fromEl && from) fromEl.textContent = from;
    if (taskEl && task) taskEl.textContent = task;
    if (filtersEl && filters) filtersEl.textContent = filters;
    if (queryEl && query) queryEl.textContent = query;
    if (accentEl && accent) accentEl.textContent = accent;
    if (bodyEl && body) bodyEl.textContent = body;
    if (ctaEl && cta) ctaEl.textContent = cta;

    if (announce) {
      [fromEl, taskEl, filtersEl, queryEl, accentEl, bodyEl, ctaEl].forEach(flash);
      if (announcerEl) announcerEl.textContent = content[lang].ui.nowViewingAs(label ?? button.textContent?.trim() ?? '');
    }
  }

  function persistAudience(id: string) {
    const url = new URL(window.location.href);
    url.searchParams.set('as', id);
    window.history.replaceState({}, '', url);
    try {
      window.localStorage.setItem(STORAGE_KEY, id);
    } catch {
      // storage may be unavailable (private mode) — persisting is a nice-to-have
    }
  }

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      applyAudience(button);
      if (button.dataset.audience) persistAudience(button.dataset.audience);
    });
  });

  // Restore a shared (?as=) or previously-chosen audience on load, and always
  // re-render text for whichever language was detected — the buttons are
  // server-rendered in English, so a Spanish-detected visitor needs this
  // pass even when the audience itself never changes.
  let initialId = new URLSearchParams(window.location.search).get('as');
  if (!initialId) {
    try {
      initialId = window.localStorage.getItem(STORAGE_KEY);
    } catch {
      initialId = null;
    }
  }
  const initialButton =
    (initialId && Array.from(buttons).find((b) => b.dataset.audience === initialId)) || buttons[0];
  if (initialButton) {
    applyAudience(initialButton, false);
    if (initialId) persistAudience(initialId);
  }

  onLangChange(() => {
    const pressed = Array.from(buttons).find((b) => b.getAttribute('aria-pressed') === 'true');
    if (pressed) applyAudience(pressed, false);
  });

  // Highlight the trace-step link for whichever step is currently in view.
  const traceLinks = new Map<string, HTMLAnchorElement>();
  document
    .querySelectorAll<HTMLAnchorElement>('nav[aria-label="Trace steps"] a')
    .forEach((link) => {
      const id = link.getAttribute('href')?.slice(1);
      if (id) traceLinks.set(id, link);
    });

  const stepIds = Array.from(traceLinks.keys());
  const contextFillEl = document.getElementById('context-fill');
  const contextCountEl = document.getElementById('context-count');
  const contextTrackEl = document.querySelector<HTMLElement>('.context-track');
  let furthestStepIndex = 0;

  function updateContextBar(index: number) {
    if (index <= furthestStepIndex) return;
    furthestStepIndex = index;
    const total = stepIds.length;
    const pct = Math.round(((index + 1) / total) * 100);
    if (contextFillEl) contextFillEl.style.width = `${pct}%`;
    if (contextCountEl) contextCountEl.textContent = `${pct}%`;
    contextTrackEl?.setAttribute('aria-valuenow', String(pct));
  }

  const stepObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        const link = traceLinks.get(entry.target.id);
        if (!link) return;
        link.classList.toggle('active', entry.isIntersecting);
        link.toggleAttribute('aria-current', entry.isIntersecting);
        if (entry.isIntersecting) {
          const index = stepIds.indexOf(entry.target.id);
          if (index !== -1) updateContextBar(index);
        }
      });
    },
    { rootMargin: '-40% 0px -50% 0px' }
  );

  traceLinks.forEach((_link, id) => {
    const section = document.getElementById(id);
    if (section) stepObserver.observe(section);
  });
</script>

<style>
  .sidebar {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow-y: auto;
    border-right: 1px solid var(--color-border);
    padding: 28px 24px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .status {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-accent);
    animation: pulse 1.6s ease infinite;
  }

  .agent-name {
    font: 700 14px var(--font-mono);
    color: var(--color-accent);
  }

  .comment {
    color: var(--color-text-faint);
    font-size: 12px;
    margin: 0 0 6px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .toggle {
    display: flex;
    gap: 4px;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 3px;
  }

  .toggle button {
    flex: 1;
    background: transparent;
    border: none;
    border-radius: 5px;
    color: var(--color-text-dim);
    font: 500 12px var(--font-mono);
    padding: 6px 8px;
    cursor: pointer;
  }

  .toggle button:hover {
    color: var(--color-text);
  }

  .toggle button[aria-pressed='true'] {
    background: var(--color-accent);
    color: var(--color-on-accent);
    font-weight: 700;
  }

  .session {
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: 12px 14px;
    font-size: 12px;
    line-height: 1.7;
    color: var(--color-text-dim);
    margin: 0;
  }

  .session .row {
    display: flex;
    gap: 6px;
  }

  .session dt {
    font-weight: 400;
  }

  .session dd {
    margin: 0;
    color: var(--color-text);
  }

  .status-ok {
    color: var(--color-success) !important;
  }

  nav ol {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 13px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    display: block;
    padding: 7px 10px;
    border-radius: 6px;
    color: var(--color-text-dim);
  }

  nav a:hover,
  nav a:focus-visible {
    background: var(--color-surface-alt);
    color: var(--color-accent);
  }

  nav a.active {
    background: var(--color-surface-alt);
    color: var(--color-accent);
  }

  .context-group {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .context {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .context-label {
    display: flex;
    justify-content: space-between;
    font: 500 11px var(--font-mono);
    color: var(--color-text-faint);
  }

  .context-track {
    height: 4px;
    border-radius: 2px;
    background: var(--color-border);
    overflow: hidden;
  }

  .context-fill {
    height: 100%;
    width: 20%;
    background: var(--color-accent);
    border-radius: 2px;
    transition: width 0.4s ease;
  }

  .raw-data-hint {
    font-size: 11px;
    margin: 0;
  }

  @media (max-width: 900px) {
    .sidebar {
      position: static !important;
      height: auto !important;
      border-right: none;
      border-bottom: 1px solid var(--color-border);
    }

    nav ol {
      flex-direction: row;
      flex-wrap: wrap;
    }
  }
</style>
