---
import { Image } from 'astro:assets';
import profileImage from '../../assets/profile.jpg';
import { content } from '../../i18n/content';
import ToolCallHeader from './ToolCallHeader.astro';

const { site, profile, calls } = content.en;
---

<section id="step1" class="step" aria-labelledby="step1-heading">
  <ToolCallHeader
    call={calls.profile}
    status={calls.profileStatus}
    plainLabelKey="loadingProfile"
    resolveDelay={0.1}
  />
  <div class="card">
    <Image
      id="profile-photo"
      src={profileImage}
      alt={`Portrait of ${site.name}`}
      width={200}
      height={230}
      densities={[1, 2, 3]}
      loading="eager"
      fetchpriority="high"
    />
    <div>
      <h1 id="step1-heading">{site.name}</h1>
      <p class="tagline" data-i18n="profile.tagline">{profile.tagline}</p>
      <p class="bio" data-i18n="profile.bio">{profile.bio}</p>
    </div>
  </div>
</section>

<script>
  import { getCurrentLang, onLangChange, content } from '../../i18n/client';

  const img = document.getElementById('profile-photo');
  const name = content.en.site.name;

  function updateAlt(lang: 'en' | 'es') {
    img?.setAttribute('alt', content[lang].ui.profileAlt(name));
  }

  updateAlt(getCurrentLang());
  onLangChange(updateAlt);
</script>

<style>
  .step {
    animation: rise 0.6s 0.1s ease both;
    margin-bottom: 36px;
  }

  .card {
    border: 1px solid var(--color-border-strong);
    border-radius: 14px;
    padding: 32px 36px;
    background: var(--color-surface);
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 32px;
    align-items: center;
  }

  .card :global(img) {
    width: 200px;
    height: 230px;
    object-fit: cover;
    border-radius: 10px;
    border: 1px solid var(--color-border-strong);
    filter: saturate(0.85);
  }

  h1 {
    margin: 0 0 10px;
    font: 700 42px/1.05 var(--font-sans);
    letter-spacing: -1.5px;
  }

  .tagline {
    font-size: 13px;
    color: var(--color-accent);
    margin: 0 0 14px;
  }

  .bio {
    margin: 0;
    font: 400 16px/1.7 var(--font-sans);
    color: var(--color-text-muted);
  }

  @media (max-width: 640px) {
    .card {
      grid-template-columns: 1fr;
      padding: 24px;
    }

    .card :global(img) {
      width: 100%;
      height: auto;
      aspect-ratio: 200 / 230;
    }
  }
</style>
