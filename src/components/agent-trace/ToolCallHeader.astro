---
interface Props {
  call: string;
  status?: string;
  variant?: 'tool' | 'final';
  plainLabel?: string;
}

const { call, status, variant = 'tool', plainLabel } = Astro.props;
---

<div class="header">
  <span class:list={['badge', variant]}>{variant === 'final' ? 'FINAL ANSWER' : 'TOOL CALL'}</span>
  <span class="call" title={plainLabel} aria-label={plainLabel ?? call}>{call}</span>
  {status && <span class="status">✓ {status}</span>}
</div>

<style>
  .header {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 12px;
  }

  .badge {
    font: 700 11px var(--font-mono);
    padding: 4px 10px;
    border-radius: 4px;
    color: var(--color-on-accent);
  }

  .badge.tool {
    background: var(--color-accent);
  }

  .badge.final {
    background: var(--color-success);
  }

  .call {
    font-size: 13px;
    color: var(--color-accent);
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .status {
    font-size: 12px;
    color: var(--color-success);
  }
</style>
