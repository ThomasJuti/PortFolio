---
import { projects } from '../../data/site';
import ToolCallHeader from './ToolCallHeader.astro';
import ProjectEntry from './ProjectEntry.astro';

const spotlight = projects.find((p) => p.layout === 'spotlight')!;
const paired = projects.filter((p) => p.layout === 'default');
const wide = projects.filter((p) => p.layout === 'wide');
---

<section id="step2" class="step" aria-labelledby="step2-heading">
  <ToolCallHeader call={spotlight.call!} status={spotlight.status!} />
  <h2 id="step2-heading" class="sr-only">Projects</h2>
  <div class="list">
    <ProjectEntry
      title={spotlight.title}
      description={spotlight.description}
      stack={spotlight.stack}
      badge={spotlight.badge}
      layout="spotlight"
    />
    <div class="pair">
      {
        paired.map((project) => (
          <ProjectEntry
            title={project.title}
            description={project.description}
            stack={project.stack}
            layout="default"
          />
        ))
      }
    </div>
    {
      wide.map((project) => (
        <ProjectEntry
          title={project.title}
          description={project.description}
          stack={project.stack}
          layout="wide"
        />
      ))
    }
  </div>
</section>

<style>
  .step {
    animation: rise 0.6s 0.2s ease both;
    margin-bottom: 36px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  @media (max-width: 640px) {
    .pair {
      grid-template-columns: 1fr;
    }
  }
</style>
