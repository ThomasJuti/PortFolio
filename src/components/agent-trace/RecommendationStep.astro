---
import { audiences, recommendation, site } from '../../data/site';
import ToolCallHeader from './ToolCallHeader.astro';

const current = audiences[0];
const year = new Date().getFullYear();
---

<section id="step5" class="step" aria-labelledby="step5-heading">
  <ToolCallHeader call={recommendation.call} variant="final" plainLabel="making the call" />
  <div class="card">
    <h2 id="step5-heading">
      {recommendation.headline} <span class="accent" id="rec-accent">{current.accent}</span>
    </h2>
    <p class="body" id="rec-body">{current.body}</p>
    <div class="actions">
      <a class="btn-primary" href={`mailto:${site.email}`} id="rec-cta">{current.cta}</a>
      <a class="btn-secondary" href={site.github} target="_blank" rel="noopener noreferrer"
        >GitHub ↗</a
      >
      <a class="btn-secondary" href={site.linkedin} target="_blank" rel="noopener noreferrer"
        >LinkedIn ↗</a
      >
    </div>
    <div class="email-row">
      <span class="email-text" id="rec-email-text">{site.email}</span>
      <button
        type="button"
        class="copy-btn"
        id="copy-email-btn"
        aria-label={`Copy email address ${site.email}`}
      >
        <span id="copy-btn-label">Copy</span>
      </button>
    </div>
  </div>
  <p class="fine-print">© {year} thomas jutinico · this portfolio is itself an agent trace 🤖</p>
</section>

<script>
  const emailText = document.getElementById('rec-email-text');
  const copyBtn = document.getElementById('copy-email-btn');
  const copyLabel = document.getElementById('copy-btn-label');

  copyBtn?.addEventListener('click', async () => {
    const email = emailText?.textContent?.trim();
    if (!email) return;

    try {
      await navigator.clipboard.writeText(email);
      if (copyLabel) copyLabel.textContent = 'Copied';
      copyBtn.setAttribute('data-copied', 'true');
      setTimeout(() => {
        if (copyLabel) copyLabel.textContent = 'Copy';
        copyBtn.removeAttribute('data-copied');
      }, 2000);
    } catch {
      // Clipboard API unavailable (insecure context, permissions) — email text stays selectable.
    }
  });
</script>

<style>
  .step {
    animation: rise 0.6s 0.5s ease both;
  }

  .card {
    border: 1px solid var(--color-accent);
    border-radius: 14px;
    padding: 40px 44px;
    background: var(--color-surface-gradient);
    text-align: center;
  }

  h2 {
    font: 700 34px var(--font-sans);
    letter-spacing: -1px;
    margin: 0 0 10px;
  }

  .accent {
    color: var(--color-accent);
  }

  .body {
    margin: 0 auto 26px;
    font: 400 16px/1.7 var(--font-sans);
    color: var(--color-text-muted);
    max-width: 520px;
  }

  .actions {
    display: flex;
    gap: 14px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn-primary,
  .btn-secondary {
    font: 700 15px var(--font-sans);
    padding: 14px 30px;
    border-radius: 8px;
    display: inline-block;
  }

  .btn-primary {
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  .btn-primary:hover {
    background: var(--color-accent-hover);
    color: var(--color-on-accent);
  }

  .btn-secondary {
    border: 1px solid var(--color-border-strong);
    color: var(--color-text);
    font-weight: 500;
  }

  .btn-secondary:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .fine-print {
    text-align: center;
    margin-top: 36px;
    font-size: 11px;
    color: var(--color-text-faint);
  }

  .email-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-top: 18px;
    flex-wrap: wrap;
  }

  .email-text {
    font: 500 13px var(--font-mono);
    color: var(--color-text-dim);
    user-select: all;
  }

  .copy-btn {
    font: 600 12px var(--font-mono);
    color: var(--color-text-dim);
    background: transparent;
    border: 1px solid var(--color-border-strong);
    border-radius: 6px;
    padding: 5px 12px;
    cursor: pointer;
    transition:
      border-color 0.15s,
      color 0.15s;
  }

  .copy-btn:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .copy-btn[data-copied='true'] {
    border-color: var(--color-success);
    color: var(--color-success);
  }
</style>
