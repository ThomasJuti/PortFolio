---
import { audiences, recommendation, site } from '../../data/site';
import ToolCallHeader from './ToolCallHeader.astro';

const current = audiences[0];
const year = new Date().getFullYear();
---

<section id="step5" class="step" aria-labelledby="step5-heading">
  <ToolCallHeader
    call={recommendation.call}
    variant="final"
    plainLabel="making the call"
    resolveDelay={0.5}
  />
  <div class="card">
    <ul class="reasoning" id="rec-reasoning" aria-hidden="true">
      <li class="think-line">
        checking production wins... <span class="check">✓</span>
      </li>
      <li class="think-line">
        checking real deploys... <span class="check">✓</span>
      </li>
      <li class="think-line">
        cross-referencing persona filters... <span class="check">✓</span>
      </li>
    </ul>
    <h2 id="step5-heading">
      {recommendation.headline} <span class="accent" id="rec-accent">{current.accent}</span>
    </h2>
    <p class="body" id="rec-body">{current.body}</p>
    <div class="actions">
      <a class="btn-primary" href={`mailto:${site.email}`} id="rec-cta">{current.cta}</a>
      <a class="btn-secondary" href={site.github} target="_blank" rel="noopener noreferrer"
        >GitHub ↗</a
      >
      <a class="btn-secondary" href={site.linkedin} target="_blank" rel="noopener noreferrer"
        >LinkedIn ↗</a
      >
    </div>
    <div class="email-row">
      <span class="email-text" id="rec-email-text">{site.email}</span>
      <button
        type="button"
        class="copy-btn"
        id="copy-email-btn"
        aria-label={`Copy email address ${site.email}`}
      >
        <span id="copy-btn-label">Copy</span>
      </button>
    </div>
  </div>
  <p class="fine-print">© {year} thomas jutinico · this portfolio is itself an agent trace 🤖</p>
</section>

<script>
  const emailText = document.getElementById('rec-email-text');
  const copyBtn = document.getElementById('copy-email-btn');
  const copyLabel = document.getElementById('copy-btn-label');

  copyBtn?.addEventListener('click', async () => {
    const email = emailText?.textContent?.trim();
    if (!email) return;

    try {
      await navigator.clipboard.writeText(email);
      if (copyLabel) copyLabel.textContent = 'Copied';
      copyBtn.setAttribute('data-copied', 'true');
      setTimeout(() => {
        if (copyLabel) copyLabel.textContent = 'Copy';
        copyBtn.removeAttribute('data-copied');
      }, 2000);
    } catch {
      // Clipboard API unavailable (insecure context, permissions) — email text stays selectable.
    }
  });
</script>

<script>
  // Reasoning-then-stream reveal, played once the first time this section
  // scrolls into view. Headline/body are hidden via opacity only (never their
  // text content) so that if the visitor swaps persona via AgentSidebar
  // before ever scrolling here, the body still reads its *live* text at
  // stream time instead of a stale value captured on page load.
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const section = document.getElementById('step5');
  const reasoningEl = document.getElementById('rec-reasoning');
  const headlineEl = document.getElementById('step5-heading');
  const bodyEl = document.getElementById('rec-body');

  if (!prefersReducedMotion && section && reasoningEl && headlineEl && bodyEl) {
    headlineEl.classList.add('pending-reveal');
    bodyEl.classList.add('pending-reveal');

    const lines = Array.from(reasoningEl.querySelectorAll<HTMLElement>('.think-line'));
    const LINE_STAGGER_MS = 180;
    const STREAM_SPEED_MS = 18;

    function streamText(el: HTMLElement, text: string) {
      let i = 0;
      function tick() {
        el.textContent = text.slice(0, i);
        i++;
        if (i <= text.length) window.setTimeout(tick, STREAM_SPEED_MS);
      }
      tick();
    }

    function playSequence() {
      lines.forEach((line, i) => {
        window.setTimeout(() => line.classList.add('shown'), i * LINE_STAGGER_MS);
      });

      const reasoningDone = lines.length * LINE_STAGGER_MS + 300;

      window.setTimeout(() => {
        headlineEl.classList.remove('pending-reveal');
      }, reasoningDone);

      window.setTimeout(() => {
        const fullText = bodyEl.textContent ?? '';
        bodyEl.textContent = '';
        bodyEl.classList.remove('pending-reveal');
        streamText(bodyEl, fullText);
      }, reasoningDone + 250);
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            observer.disconnect();
            playSequence();
          }
        });
      },
      { threshold: 0.4 }
    );
    observer.observe(section);
  }
</script>

<style>
  .step {
    animation: rise 0.6s 0.5s ease both;
  }

  .card {
    border: 1px solid var(--color-accent);
    border-radius: 14px;
    padding: 40px 44px;
    background: var(--color-surface-gradient);
    text-align: center;
  }

  .reasoning {
    list-style: none;
    margin: 0 0 20px;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }

  .think-line {
    font: 500 12px var(--font-mono);
    color: var(--color-text-faint);
    opacity: 0;
    transform: translateY(4px);
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
  }

  .think-line.shown {
    opacity: 1;
    transform: translateY(0);
  }

  .think-line .check {
    color: var(--color-success);
  }

  h2 {
    font: 700 34px var(--font-sans);
    letter-spacing: -1px;
    margin: 0 0 10px;
    transition:
      opacity 0.4s ease,
      transform 0.4s ease;
  }

  .accent {
    color: var(--color-accent);
  }

  .body {
    margin: 0 auto 26px;
    font: 400 16px/1.7 var(--font-sans);
    color: var(--color-text-muted);
    max-width: 520px;
    min-height: 1.7em;
    transition:
      opacity 0.4s ease,
      transform 0.4s ease;
  }

  .pending-reveal {
    opacity: 0;
    transform: translateY(6px);
  }

  .actions {
    display: flex;
    gap: 14px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn-primary,
  .btn-secondary {
    font: 700 15px var(--font-sans);
    padding: 14px 30px;
    border-radius: 8px;
    display: inline-block;
  }

  .btn-primary {
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  .btn-primary:hover {
    background: var(--color-accent-hover);
    color: var(--color-on-accent);
  }

  .btn-secondary {
    border: 1px solid var(--color-border-strong);
    color: var(--color-text);
    font-weight: 500;
  }

  .btn-secondary:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .fine-print {
    text-align: center;
    margin-top: 36px;
    font-size: 11px;
    color: var(--color-text-faint);
  }

  .email-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-top: 18px;
    flex-wrap: wrap;
  }

  .email-text {
    font: 500 13px var(--font-mono);
    color: var(--color-text-dim);
    user-select: all;
  }

  .copy-btn {
    font: 600 12px var(--font-mono);
    color: var(--color-text-dim);
    background: transparent;
    border: 1px solid var(--color-border-strong);
    border-radius: 6px;
    padding: 5px 12px;
    cursor: pointer;
    transition:
      border-color 0.15s,
      color 0.15s;
  }

  .copy-btn:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .copy-btn[data-copied='true'] {
    border-color: var(--color-success);
    color: var(--color-success);
  }
</style>
